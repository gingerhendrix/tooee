{
  "name": "tooee-docs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "content": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "check": "bun run content && bun run typecheck",
    "plan": "alchemy plan --stage prod",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod"
  },
  "dependencies": {
    "@fumadocs/changelog": "^0.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.166.2",
    "@tanstack/react-start": "1.166.2",
    "@tanstack/router-plugin": "1.166.2",
    "cn": "^0.5.2",
    "fumadocs-core": "^16.18.4",
    "fumadocs-mdx": "^15.0.11",
    "fumadocs-ui": "^16.18.4",
    "geist": "^1.7.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "^7.0.2",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
