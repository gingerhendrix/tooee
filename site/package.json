{
  "name": "tooee-docs",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "content": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "check": "bun run content && bun run typecheck",
    "plan": "alchemy plan --stage prod",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod"
  },
  "dependencies": {
    "@fumadocs/changelog": "^0.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/router-plugin": "1.168.43",
    "cn": "^0.5.2",
    "fumadocs-core": "^16.19.5",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "^16.19.5",
    "geist": "^1.9.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "typescript": "^7.0.2",
    "vite": "7.3.8",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "patchedDependencies": {
    "@fumadocs/changelog@0.1.0": "patches/@fumadocs%2Fchangelog@0.1.0.patch"
  }
